[application]
config/name="ASTrix"
config/description="A living voxel world managed by a human-supervised TrueForge Steward"
run/main_scene="res://scenes/Main.tscn"

[autoload]
GameClient="*res://scripts/GameClient.gd"
AstrixInput="*res://scripts/AstrixInput.gd"
WorldState="*res://scripts/WorldState.gd"
GameCommandBus="*res://scripts/GameCommandBus.gd"
MCPToolRegistry="*res://scripts/MCPToolRegistry.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
run={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
action={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[environment]
defaults/default_clear_color=Color(0.72, 0.84, 0.86, 1)
