# Build-time only. For the recommended single-origin deploy (pm2 / Fly.io) this
# stays unset and the frontend talks to the same host that served it (default
# same-origin, no other value needed).
#
# For a SPLIT deploy — static frontend on Vercel, game server elsewhere — set
# this to the game server's origin BEFORE building, e.g.:
#   VITE_API_URL="https://game.example.com" npm run build
# VITE_API_URL=https://game.example.com

# Runtime (game server). Default is "scripted"; switch to TrueForge agents when configured.
# BOTS=scripted
# PORT=8787